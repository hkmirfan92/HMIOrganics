rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Primitives
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerified() && (
        request.auth.token.email == 'hkirfan92@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidProduct(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.category is string && data.category.size() <= 100 &&
             data.pricePkr is number && data.pricePkr >= 0;
    }

    function isValidCategory(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100;
    }

    // Public Product Catalog: Customers read all, Admins write
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isValidId(productId) && isAdmin() && isValidProduct(request.resource.data);
      allow delete: if isValidId(productId) && isAdmin();
    }

    // Product Categories: Public read, Admin write
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if isValidId(categoryId) && isAdmin() && isValidCategory(request.resource.data);
      allow delete: if isValidId(categoryId) && isAdmin();
    }

    // Brand Settings (Phone, Landline, Address, Products Per Page): Public read, Admin write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId) && isAdmin();
    }

    // Site Page Text & Banners: Public read, Admin write
    match /pages/{pageId} {
      allow read: if true;
      allow write: if isValidId(pageId) && isAdmin();
    }

    // Site SEO & Verification Codes: Public read, Admin write
    match /seo/{seoId} {
      allow read: if true;
      allow write: if isValidId(seoId) && isAdmin();
    }

    // Admin Users List: Strictly Admin only
    match /admins/{adminId} {
      allow read, write: if isValidId(adminId) && isAdmin();
    }
  }
}
