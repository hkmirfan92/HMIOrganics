rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Primitives & Schema Validation
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidProduct(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.category is string && data.category.size() <= 100 &&
             data.pricePkr is number && data.pricePkr >= 0;
    }

    function isValidCategory(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100;
    }

    // Products Catalog: Public read, Validated schema writes (Vercel & AI Studio)
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isValidId(productId) && isValidProduct(request.resource.data);
      allow delete: if isValidId(productId);
    }

    // Product Categories: Public read, Validated schema writes
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if isValidId(categoryId) && isValidCategory(request.resource.data);
      allow delete: if isValidId(categoryId);
    }

    // Brand Settings (Phone, Landline, Address, Products Per Page): Public read, Validated write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId);
    }

    // Site Page Text & Banners: Public read, Validated write
    match /pages/{pageId} {
      allow read: if true;
      allow write: if isValidId(pageId);
    }

    // Site SEO & Verification Codes: Public read, Validated write
    match /seo/{seoId} {
      allow read: if true;
      allow write: if isValidId(seoId);
    }

    // Admin Users List: Validated write
    match /admins/{adminId} {
      allow read, write: if isValidId(adminId);
    }
  }
}
